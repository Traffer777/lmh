# Скопируйте в .env и заполните.

# База данных. Демо — SQLite. Прод — PostgreSQL (поменять provider в prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Режим оплаты: mock (демо без ключей) | test (тестовые ключи) | live (боевые)
PAYMENT_MODE="mock"

# ЮKassa (СБП, карты). Берётся в личном кабинете: Настройки → API.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Т-Банк «Долями» (оплата в 4 части) — отдельный терминал, выдаёт банк при подключении сервиса.
TBANK_DOLYAMI_TERMINAL_KEY=""
TBANK_DOLYAMI_PASSWORD=""

# СДЭК — расчёт доставки до ПВЗ. Account + Secure password из ЛК СДЭК → Интеграция → API.
CDEK_ACCOUNT=""
CDEK_PASSWORD=""
# Код ПВЗ СДЭК, куда владелец сдаёт посылки (точка отправления).
CDEK_SHIPMENT_POINT="MSK156"

# Доступ в админку /admin
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="смените-пароль"
ADMIN_SECRET="случайная-строка-минимум-32-символа"

# URL сайта (для callback'ов оплаты)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Порог бесплатной доставки, руб.
FREE_SHIPPING_THRESHOLD="15000"

# Уведомления о заказах в Telegram (опционально)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Конкурс LMH × ГЛЕБАС — интеграция с ботом розыгрыша.
# LMH_BOT_WEBHOOK_URL — куда магазин пушит подписанный payload при оплате.
# LMH_BOT_SECRET      — общий секрет для HMAC-SHA256 (заголовок x-lmh-signature).
# LMH_BOT_API         — базовый URL API бота (магазин читает GET /counter для баннера).
LMH_BOT_WEBHOOK_URL=""
LMH_BOT_SECRET=""
LMH_BOT_API=""
